/-- The genuine coefficient cache, with zero outside its checked finite range. -/
def cachedIncomingCoefficient (n : ℕ) : ℚ := incomingCoefficientTable.getD n 0

/-- Every cached coefficient equals the actual original incoming-tail coefficient. -/
theorem cachedIncomingCoefficient_eq {n : ℕ} (hn : n < 75) :
    cachedIncomingCoefficient n = radialIncomingCoefficient n := by
  have h : ∀ k : Fin 75, cachedIncomingCoefficient k.val = radialIncomingCoefficient k.val := by
    decide +kernel
  exact h ⟨n, hn⟩

