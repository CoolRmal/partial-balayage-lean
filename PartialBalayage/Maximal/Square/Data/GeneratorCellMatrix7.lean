/-- All candidate entries are the actual signed generator cubic coefficients. -/
theorem generatorCellMatrix7_correct (k : Fin 53) (b : Fin 4) :
    splineGeneratorCellCoefficient 7 ((k.val : ℤ) - 26) b =
      generatorCellMatrix7 k b := by
  rw [splineGeneratorCellCoefficient_eq_literal]
  have h : ∀ k : Fin 53, ∀ b : Fin 4,
      literalGeneratorCellCoefficient 7 ((k.val : ℤ) - 26) b =
        generatorCellMatrix7 k b := by
    decide +kernel
  exact h k b

