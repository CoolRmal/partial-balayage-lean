/-- All candidate entries are the actual signed generator cubic coefficients. -/
theorem generatorCellMatrix21_correct (k : Fin 53) (b : Fin 4) :
    splineGeneratorCellCoefficient 21 ((k.val : ℤ) - 26) b =
      generatorCellMatrix21 k b := by
  rw [splineGeneratorCellCoefficient_eq_literal]
  have h : ∀ k : Fin 53, ∀ b : Fin 4,
      literalGeneratorCellCoefficient 21 ((k.val : ℤ) - 26) b =
        generatorCellMatrix21 k b := by
    decide +kernel
  exact h k b

