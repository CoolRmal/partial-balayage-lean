/-- All candidate entries are the actual signed generator cubic coefficients. -/
theorem generatorCellMatrix5_correct (k : Fin 53) (b : Fin 4) :
    splineGeneratorCellCoefficient 5 ((k.val : ℤ) - 26) b =
      generatorCellMatrix5 k b := by
  rw [splineGeneratorCellCoefficient_eq_literal]
  have h : ∀ k : Fin 53, ∀ b : Fin 4,
      literalGeneratorCellCoefficient 5 ((k.val : ℤ) - 26) b =
        generatorCellMatrix5 k b := by
    decide +kernel
  exact h k b

