/-- Every normalized coefficient is the original exact checked coefficient. -/
theorem normalizedGeneratorCellMatrix24_eq :
    normalizedGeneratorCellMatrix24 = generatorCellMatrix24 := by
  funext k b
  have h : ∀ j : Fin 53, ∀ a : Fin 4,
      normalizedGeneratorCellMatrix24 j a = generatorCellMatrix24 j a := by
    decide +kernel
  exact h k b

