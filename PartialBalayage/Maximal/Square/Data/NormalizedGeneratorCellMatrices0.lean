/-- Every normalized coefficient is the original exact checked coefficient. -/
theorem normalizedGeneratorCellMatrix3_eq :
    normalizedGeneratorCellMatrix3 = generatorCellMatrix3 := by
  funext k b
  have h : ∀ j : Fin 53, ∀ a : Fin 4,
      normalizedGeneratorCellMatrix3 j a = generatorCellMatrix3 j a := by
    decide +kernel
  exact h k b

