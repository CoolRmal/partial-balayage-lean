/-- Every normalized coefficient is the original exact checked coefficient. -/
theorem normalizedGeneratorCellMatrix0_eq :
    normalizedGeneratorCellMatrix0 = generatorCellMatrix0 := by
  funext k b
  have h : ∀ j : Fin 53, ∀ a : Fin 4,
      normalizedGeneratorCellMatrix0 j a = generatorCellMatrix0 j a := by
    decide +kernel
  exact h k b

