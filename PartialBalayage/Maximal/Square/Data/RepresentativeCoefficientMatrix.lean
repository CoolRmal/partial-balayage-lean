/-- Every entry is proved equal to the actual immutable representative lookup. -/
theorem representativeCoefficientMatrix_correct (i j : Fin 25) :
    representativeCoefficient i j = representativeCoefficientMatrix i j := by
  fin_cases i
  all_goals norm_num (config := { maxSteps := 1000000 }) [representativeCoefficient,
    splineOrbits, splineOrbits0, splineOrbits1, splineOrbits2, splineOrbits3, splineOrbits4,
    splineOrbits5, splineOrbits6, splineOrbits7, splineOrbits8, splineOrbits9, splineOrbits10,
    splineOrbits11, splineOrbits12]
  all_goals fin_cases j <;> norm_num [representativeCoefficientMatrix]

/-- The actual representative lookup vanishes beyond its proved first-index support. -/
theorem representativeCoefficient_eq_zero_of_24_lt_left {i : ℕ} (hi : 24 < i) (j : ℕ) :
    representativeCoefficient i j = 0 := by
  unfold representativeCoefficient
  apply List.sum_eq_zero
  intro z hz
  obtain ⟨t, ht, rfl⟩ := List.mem_map.mp hz
  have hti : t.1 ≤ 24 := by have h := (splineOrbits_admissible t ht).2; omega
  have hn : ¬ (t.1 = i ∧ t.2.1 = j) := by omega
  simp only [hn, ↓reduceIte]

/-- The actual representative lookup vanishes beyond its proved second-index support. -/
theorem representativeCoefficient_eq_zero_of_24_lt_right (i : ℕ) {j : ℕ} (hj : 24 < j) :
    representativeCoefficient i j = 0 := by
  unfold representativeCoefficient
  apply List.sum_eq_zero
  intro z hz
  obtain ⟨t, ht, rfl⟩ := List.mem_map.mp hz
  have htj : t.2.1 ≤ 24 := by have h := (splineOrbits_admissible t ht).2; omega
  have hn : ¬ (t.1 = i ∧ t.2.1 = j) := by omega
  simp only [hn, ↓reduceIte]

/-- A transparent finite lookup, with the actual zero value beyond the coefficient box. -/
def literalRepresentativeCoefficient (i j : ℕ) : ℚ :=
  if hi : i < 25 then
    if hj : j < 25 then representativeCoefficientMatrix ⟨i, hi⟩ ⟨j, hj⟩ else 0
  else 0

/-- The finite literal cache is the actual representative coefficient function on every index. -/
theorem representativeCoefficient_eq_literal (i j : ℕ) :
    representativeCoefficient i j = literalRepresentativeCoefficient i j := by
  unfold literalRepresentativeCoefficient
  split_ifs with hi hj
  · exact representativeCoefficientMatrix_correct ⟨i, hi⟩ ⟨j, hj⟩
  · exact representativeCoefficient_eq_zero_of_24_lt_right i (by omega)
  · exact representativeCoefficient_eq_zero_of_24_lt_left (by omega) j

end PartialBalayage.Maximal.Square
